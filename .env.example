# Copy this file to .env and fill in real values for your own machine.
# Nothing here is real. .env is git-ignored; this file is not.

NOTIFIER_ENV=development
PORT=3000

# Where notifications are POSTed. The value below is a local stub, not a service.
NOTIFIER_EMAIL_ENDPOINT=http://127.0.0.1:4000/send

# The bearer token for that endpoint. Fake on purpose: it is the kind of string
# you should never see committed.
NOTIFIER_API_TOKEN=test_sk_not_a_real_token_0000

NOTIFIER_EMAIL_FROM=orders@example.test
